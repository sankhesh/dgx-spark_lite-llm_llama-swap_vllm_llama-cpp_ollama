{
  "title": "DGX Spark — Model Server",
  "uid": "dgx-spark-model-server",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    { "type": "row", "title": "LLM usage (litellm)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "collapsed": false, "panels": [] },

    {
      "type": "timeseries",
      "title": "Requests / min by model",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dgx-spark" },
      "targets": [
        {
          "expr": "sum by (requested_model) (rate(litellm_proxy_total_requests_metric_total[5m]) * 60)",
          "legendFormat": "{{requested_model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Tokens / min by model (input + output)",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dgx-spark" },
      "targets": [
        {
          "expr": "sum by (model) (rate(litellm_total_tokens_metric_total[5m]) * 60)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },

    {
      "type": "timeseries",
      "title": "p95 request latency by model",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dgx-spark" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(litellm_request_total_latency_metric_bucket[5m])))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Failed requests / min",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dgx-spark" },
      "targets": [
        {
          "expr": "sum by (requested_model) (rate(litellm_proxy_failed_requests_metric_total[5m]) * 60)",
          "legendFormat": "{{requested_model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] }
    },

    { "type": "row", "title": "GPU / hardware (llama-swap)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }, "id": 101, "collapsed": false, "panels": [] },

    {
      "type": "timeseries",
      "title": "GPU utilization %",
      "id": 5,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dgx-spark" },
      "targets": [
        { "expr": "llamaswap_gpu_util_percent", "legendFormat": "GPU util", "refId": "A" },
        { "expr": "llamaswap_gpu_memory_util_percent", "legendFormat": "VRAM util", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "GPU power draw (W)",
      "id": 6,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dgx-spark" },
      "targets": [
        { "expr": "llamaswap_gpu_power_draw_watts", "legendFormat": "power", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "watt" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "GPU / VRAM temperature (°C)",
      "id": 7,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dgx-spark" },
      "targets": [
        { "expr": "llamaswap_gpu_temperature_celsius", "legendFormat": "GPU temp", "refId": "A" },
        { "expr": "llamaswap_gpu_vram_temperature_celsius", "legendFormat": "VRAM temp", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] }
    }
  ]
}
